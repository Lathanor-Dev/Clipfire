# Copie ce fichier en ".env" et remplis les valeurs

# Ta chaîne Twitch (sans #)
TWITCH_CHANNEL=ton_pseudo

# App créée sur https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Token utilisateur (compte du streamer) avec le scope clips:edit
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Discord : Paramètres du salon > Intégrations > Webhooks > Nouveau webhook
DISCORD_WEBHOOK_URL=

# Réglages de détection (optionnels)
WINDOW_SECONDS=10
BASELINE_SECONDS=180
SPIKE_MULTIPLIER=3
MIN_MESSAGES=8
COOLDOWN_SECONDS=60
