# Copie ce fichier en ".env" et remplis les valeurs

# Ta chaîne Twitch (sans #)
TWITCH_CHANNEL=ton_pseudo

# App créée sur https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Token utilisateur (compte du streamer) avec le scope clips:edit
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Discord : Paramètres du salon > Intégrations > Webhooks > Nouveau webhook
DISCORD_WEBHOOK_URL=

# Réglages de détection (optionnels)
WINDOW_SECONDS=10
BASELINE_SECONDS=180
SPIKE_MULTIPLIER=3
MIN_MESSAGES=8
COOLDOWN_SECONDS=60

# Analyse de fin de live (optionnel)
LIVE_CLIPS=1            # 0 = pas de clip immédiat pendant le live
AUTO_ANALYZE=1          # 0 = pas d'analyse automatique à la fin du live
HL_TOP_CLIPS=10         # nombre max de moments forts clippés
HL_MIN_SCORE=4.5          # sensibilité (plus bas = plus de clips)
CLIP_BEFORE_SECONDS=25  # secondes gardées avant le pic de chat
CLIP_AFTER_SECONDS=5
HL_SKIP_START_SECONDS=240  # ignore le début du live (spam d'ouverture)
HL_MAX_MSGS_PER_USER=2     # anti-spam
HL_AUDIO_WEIGHT=1.2        # poids du volume audio (avec --local / --video / --audio)
