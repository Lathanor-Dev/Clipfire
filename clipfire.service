# Service systemd pour faire tourner Clipfire en permanence sur Linux.
# 1. Adapte User et les chemins ci-dessous
# 2. sudo cp clipfire.service /etc/systemd/system/
# 3. sudo systemctl enable --now clipfire
# Logs : journalctl -u clipfire -f

[Unit]
Description=Clipfire - Twitch auto-clip bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/clipfire
ExecStart=/opt/clipfire/.venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
